# Копирай като .env и попълни стойностите.

# Генерирай нов ключ:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# True само локално! В продукция DEBUG=False (тогава ?preview=1 не работи).
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Адрес на админ панела (по подразбиране /upravlenie/). В продукция избери свой,
# трудно отгатваем адрес и не го споделяй публично.
# ADMIN_URL=upravlenie-k7x2/
# CSRF_TRUSTED_ORIGINS=https://advent.example.bg

# MySQL
DB_ENGINE=mysql
DB_NAME=advent
DB_USER=advent
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# За бърз тест без MySQL: DB_ENGINE=sqlite
